# Public API Base URL
# - Development: leave empty or set to /api/v1 (routed via Vite proxy)
# - Production: set to https://api.yourdomain.com/api/v1 (or /api/v1 if behind reverse proxy like Nginx/Cloudflare)
VITE_API_BASE_URL="/api/v1"
