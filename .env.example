# ==============================================================================
# Oppam Counselling Platform - Unified Environment Configuration Template
# ==============================================================================
# Use this template to configure your local development environment or production deployment.
# NEVER commit real production secrets or .env files to source control!
# ==============================================================================

# ==============================================================================
# 1. BACKEND - APPLICATION & RUNTIME
# ==============================================================================
APP_NAME="Oppam Counselling Platform API"
# Options: development | test | staging | production
APP_ENV="development"
# In production, DEBUG MUST be false (enforced at startup)
DEBUG=true
API_V1_PREFIX="/api/v1"
APP_VERSION="1.0.0"

# Server Bind Address
HOST="0.0.0.0"
PORT=8000

# Trusted Reverse Proxies (e.g., Nginx, AWS ALB, Cloudflare IPs)
# Client IP in request headers will only be honored if request originates from these hosts
TRUSTED_PROXIES=["127.0.0.1", "::1"]

# CORS Configuration
# In production: MUST be explicit origins, NO wildcard "*" (enforced at startup)
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]
CORS_ALLOW_CREDENTIALS=true

# Logging
LOG_LEVEL="INFO"
LOG_JSON_FORMAT=false
REQUEST_ID_HEADER="X-Request-ID"

# ==============================================================================
# 2. BACKEND - DATABASE (MONGODB)
# ==============================================================================
# Connection string (MongoDB Atlas URI or local mongod)
MONGODB_URI="mongodb://localhost:27017"
MONGODB_DATABASE="oppam_therapy"
MONGODB_MIN_POOL_SIZE=10
MONGODB_MAX_POOL_SIZE=50
MONGODB_TIMEOUT_MS=5000

# ==============================================================================
# 3. BACKEND - AUTHENTICATION & TOKENS
# ==============================================================================
# Minimum 32 characters in production (enforced at startup)
JWT_SECRET_KEY="replace-this-in-production-with-a-secure-secret-key-min-32-chars"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Refresh Token Cookie
REFRESH_COOKIE_NAME="oppam_refresh_token"
# In production: REFRESH_COOKIE_SECURE MUST be true (HTTPS only, enforced at startup)
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE="lax"
REFRESH_COOKIE_HTTPONLY=true
REFRESH_COOKIE_PATH="/api/v1/auth"
REFRESH_COOKIE_DOMAIN=""

# OTP Security
OTP_LENGTH=4
OTP_EXPIRE_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_ATTEMPTS=5

# ==============================================================================
# 4. BACKEND - BOOKING & SESSION RUNTIME
# ==============================================================================
BOOKING_RESERVATION_TTL_SECONDS=900
SESSION_START_WINDOW_MINUTES=15
SESSION_GRACE_PERIOD_MINUTES=60

# ==============================================================================
# 5. BACKEND - PAYMENT GATEWAY (RAZORPAY)
# ==============================================================================
# Options: mock | razorpay
PAYMENT_PROVIDER="mock"
PAYMENT_WEBHOOK_SECRET="mock_webhook_secret_key_therapy_2026"

# Razorpay credentials (required if PAYMENT_PROVIDER="razorpay")
# Options: test | live
RAZORPAY_ACCOUNT_MODE="test"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Alternative credential aliases (supported by config loader)
# RZR_DEV_KEY=""
# RZR_DEV_SECRET=""
# RZR_PROD_KEY=""
# RZR_PROD_SECRET=""

# ==============================================================================
# 6. BACKEND - GOOGLE CALENDAR & GOOGLE MEET INTEGRATION
# ==============================================================================
# Enable Google Calendar API to automatically generate Meet links for sessions
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_ID="primary"
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
# Paste the full RSA private key (with newlines or \n escaped)
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""
GOOGLE_CALENDAR_DELEGATED_USER=""
GOOGLE_CALENDAR_TIMEZONE="Asia/Kolkata"

# ==============================================================================
# 7. FRONTEND - WEB CLIENT CONFIGURATION
# ==============================================================================
# Public backend API endpoint
# - Local development: "/api/v1" (routed through Vite dev server proxy)
# - Production: "https://api.yourdomain.com/api/v1" (or "/api/v1" behind reverse proxy)
VITE_API_BASE_URL="/api/v1"
