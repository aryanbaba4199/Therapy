# ==============================================================================
# Oppam Counselling Platform - Backend Environment Configuration
# ==============================================================================

# Application
APP_NAME="Oppam Counselling Platform API"
APP_ENV="development"
DEBUG=true
API_V1_PREFIX="/api/v1"
APP_VERSION="1.0.0"

# Server
HOST="0.0.0.0"
PORT=8000

# MongoDB
MONGODB_URI="mongodb://localhost:27017"
MONGODB_DATABASE="oppam_therapy"
MONGODB_MIN_POOL_SIZE=10
MONGODB_MAX_POOL_SIZE=50
MONGODB_TIMEOUT_MS=5000

# CORS (JSON array format)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
CORS_ALLOW_CREDENTIALS=true

# Security & JWT (Replace with strong random strings in production)
JWT_SECRET_KEY="generate-a-secure-secret-key-for-production-environment-use"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Payment & Razorpay Configuration
PAYMENT_PROVIDER="mock"
PAYMENT_WEBHOOK_SECRET="mock_webhook_secret_key_therapy_2026"
RAZORPAY_KEY_ID="rzp_test_placeholder_key_id"
RAZORPAY_KEY_SECRET="placeholder_razorpay_secret"
RAZORPAY_WEBHOOK_SECRET="placeholder_razorpay_webhook_secret"
RAZORPAY_ACCOUNT_MODE="test"

# Google Calendar & Google Meet Integration
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_ID="primary"
GOOGLE_SERVICE_ACCOUNT_EMAIL="therapy-meet-service@project.iam.gserviceaccount.com"
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
GOOGLE_CALENDAR_DELEGATED_USER=""
GOOGLE_CALENDAR_TIMEZONE="Asia/Kolkata"

# Logging
LOG_LEVEL="INFO"
LOG_JSON_FORMAT=false
REQUEST_ID_HEADER="X-Request-ID"
